<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
  <dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
      <dict>
        <key>NSPrivacyAccessedAPIType</key>
        <string>Authentication</string>
        <key>NSPrivacyAccessedAPITypeReason</key>
        <string>Used for authenticating users via Google Sign-In</string>
      </dict>
      <dict>
        <key>NSPrivacyAccessedAPIType</key>
        <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
        <key>NSPrivacyAccessedAPITypeReasons</key>
        <array>
          <string>CA92.1</string>
        </array>
      </dict>
    </array>
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
      <dict>
        <key>NSPrivacyCollectedDataType</key>
        <string>Email Address</string>
        <key>NSPrivacyCollectedDataTypePurpose</key>
        <string>Used for user authentication and account identification</string>
      </dict>
      <dict>
        <key>NSPrivacyCollectedDataType</key>
        <string>Identifiers</string>
        <key>NSPrivacyCollectedDataTypePurpose</key>
        <string>Used to maintain user sessions and personalize content</string>
      </dict>
    </array>
  </dict>
</plist>